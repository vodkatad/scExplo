rule pca_umap__cluster_normalized_filtered_data:
    input: normalized_filtered_data='normalized_filtered_data/normalized_filtered_{sample}.csv'
    output: pca_plot='pca/pca_{sample}.pdf', umap_component='umap_component/umap_normalized_filtered_data_{sample}.csv', cluster_cell='cluster_cell/cluster_cell_normalized_filtered_data_{sample}.csv'
    run: 
        import scanpy as sc
        import pandas as pd
        import numpy as np

        data_path=input['normalized_filtered_data']
        data=pd.read_csv(data_path,header=0,index_col=0,sep=',').T

        
        # Create AnnData with proper orientation 
        # (cells as observations/rows, genes as variables/columns)
        adata = sc.AnnData(data, dtype='float32') #float64 nan errror
        
        # Apply preprocessing safely
        sc.pp.highly_variable_genes(adata, n_top_genes=2000)
        
        # Subset to highly variable genes before PCA (recommended)
        #adata = adata[:, adata.var.highly_variable]
        
        # Run PCA and create plot
        sc.tl.pca(adata, n_comps=19)
        sc.pl.pca_variance_ratio(adata, n_pcs=19, log=True, show=False)
                
        import matplotlib.pyplot as plt

        plt.savefig(output['pca_plot'])
        plt.close()

        
        sc.pp.neighbors(adata)
        sc.tl.umap(adata)
        df = pd.DataFrame(adata.obsm['X_umap'], index=adata.obs_names, columns=['X', 'Y'])
        df.to_csv(output['umap_component'], sep=',', index=True, header=True)

        

        sc.tl.leiden(adata, resolution=0.15)
        df = pd.DataFrame(adata.obs['leiden'].values,  index=adata.obs_names, columns=['cluster'])
        df.to_csv(output['cluster_cell'], sep=',', index=True, header=True)

