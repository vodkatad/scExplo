import os
import pandas as pd

def get_all_samples():
    base_path = "count_matrix"
    results = []

    for gse_id in os.listdir(base_path):
        subdir = os.path.join(base_path, gse_id)
        if not os.path.isdir(subdir):
            continue

        annotation_file = next((f for f in os.listdir(subdir) if "annotation.txt" in f), None)
        if not annotation_file:
            continue

        annotation_path = os.path.join(subdir, annotation_file)

        try:
            df = pd.read_csv(annotation_path, sep="\t", compression="gzip")
            samples = df["Sample"].unique()
            for sample_id in samples:
                results.append((gse_id, sample_id))
        except Exception as e:
            print(f"Errore nella lettura di {annotation_path}: {e}")
            continue

    return results



