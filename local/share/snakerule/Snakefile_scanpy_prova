rule compute_qc_for_counts:
    input: counts=find_count
    output: qc_plot='qc/{sample}_qc.pdf',data='filtered_data/filtered_{sample}.csv'
    run: 
        import scanpy as sc
        import pandas as pd
        import numpy as np
        print('=============================')
        print(input['counts'])
        print(output['qc_plot'])
        print('=============================')

        data_path=input['counts']
        data=pd.read_csv(data_path,header=0,index_col=0,sep=',').T
        data.columns = [col.split(":")[1] if ":" in col else col for col in data.columns]
        # salvo il dataframe in un annData e metto nomi di variabilie e obs unici(controllo che non ci siano geni con nomi duplicati)
        adata = sc.AnnData(data,dtype='float64')
        adata.var_names_make_unique()
        adata.obs_names_make_unique()
        #QC plot

        # mitochondrial genes, "MT-" for human, "Mt-" for mouse
        adata.var["mt"] = adata.var_names.str.startswith("MT-")
        # ribosomal genes
        adata.var["ribo"] = adata.var_names.str.startswith(("RPS", "RPL"))
        sc.pp.calculate_qc_metrics(
            adata, qc_vars=["mt", "ribo"], inplace=True, log1p=True
        )
        sc.pl.violin(
            adata,
            ["n_genes_by_counts", "total_counts"],
            jitter=0.4,
            multi_panel=True,
            show=False,
        )
        import matplotlib.pyplot as plt
        plt.savefig(output['qc_plot'])
        plt.close()

        sc.pp.filter_cells(adata, min_genes=100)
        sc.pp.filter_genes(adata, min_cells=3)

        df = pd.DataFrame(adata.X, index=adata.obs_names, columns=adata.var_names)
        #print(df.head())

        df.to_csv(output['data'], sep=',', index=True, header=True)


