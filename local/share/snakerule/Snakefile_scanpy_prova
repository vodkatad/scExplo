def get_input_files(wildcards):
    base_dir = f"count_matrix/{wildcards.GSE_id}"
    files = os.listdir(base_dir)

    annotation_file = next((f for f in files if "annotation.txt" in f), None)
    count_matrix_file = next((f for f in files if "count_matrix.txt" in f), None)

    if not annotation_file or not count_matrix_file:
        raise ValueError(f"File mancanti nella cartella {base_dir}")

    return {
        "cell_annotation_path": os.path.join(base_dir, annotation_file),
        "count_matrix_path": os.path.join(base_dir, count_matrix_file)
    }
