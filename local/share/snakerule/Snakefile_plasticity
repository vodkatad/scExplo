PRJ_ROOT='/mnt/cold1/snaketree/prj/scRNA'
SIGN=PRJ_ROOT+'/local/share/data/signatures_erc'

SIGNATURES=['stem', 'onf', 'colon', 'esophagus']
# egrassi@ulisse:/mnt/cold1/snaketree/prj/scRNA/local/share/data/signatures_erc$ grep colon plasticity_score_Lukonin_tab_8.tsv | cut -f 2 > colon.txt
# egrassi@ulisse:/mnt/cold1/snaketree/prj/scRNA/local/share/data/signatures_erc$ grep esophagus plasticity_score_Lukonin_tab_8.tsv | cut -f 2 > esophagus.txt

# onf and stem from Guccione, colon and esophagus put together from lukonin
rule guccione_sign:
    input: SIGN+"/{sign}.txt"
    output: "{sign}_mm.tsv"
    shell:  "ln -s {input} {output}"

rule to_mouse:
    input: genes="{sign}_mm.tsv"
    output: outf="{sign}_hs.tsv"
    log: log="{sign}_hs.log"
    script:  PRJ_ROOT+"/local/src/get_human_ortho.R"

rule all_sign:
    input: expand('{sign}_hs.tsv', sign=SIGNATURES)

