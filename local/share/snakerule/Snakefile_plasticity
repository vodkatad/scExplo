# keep both ensg gs translate with them then only
rule map:
    input: counts=US_DIR+'/{sample}_dir/annotated_{sample}.tsv', map=MAP
    output: counts="us/{sample}.csv"
    shell: 
        """
         tr "," "\\t" < {input.counts} | tr -d '"' | tee >(bawk 'NR==1' | tr "\\t" "," > {output.counts}.tmp1) | translate -k <(bawk '{{print $2":"$1, $1}}' {input.map}) 1 | tr "\\t" "," > {output.counts}.tmp2
         cat {output.counts}.tmp1 {output.counts}.tmp2 > {output.counts}
        """

