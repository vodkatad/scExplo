def find_count(wildcards):
    return PRJ_ROOT+'/dataset/'+DIC_FOLDER[wildcards.sample]+'/{sample}_dir/{sample}.tsv'
rule decode_pkl:
    input:data_id='data_ID/ID_across_scales.pkl', raw=find_count
    output:id_csv='ID_{n}/{sample}_ID.csv'
    run:
        import pickle 
        id_path=input['data_id']
        coun_path=input['raw']
        sample=coun_path.split('/')[-1]
        n=str(wildcards.n)
        print('=============================')
        print(sample)

        with open(id_path, 'rb') as f:
            data_id = pickle.load(f)
        import csv
        with open(coun_path, mode='r', encoding='utf-8') as file:
            reader = csv.reader(file)
            cell_id = next(reader)  
        import pandas as pd
        id=data_id[sample][n]
        out=pd.DataFrame({'cell_id':cell_id[1:len(cell_id)],'id':id})
        out.to_csv(output['id_csv'],index=False)        
        
rule all_decode_pkl:
    input:expand('ID_{n}/{sample}_ID.csv', sample=SAMPLES,n=130)
